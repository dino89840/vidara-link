{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "vidara-stable-link",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-14",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vidara-links",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
